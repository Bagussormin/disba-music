# Encryption & Security
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_long
ENCRYPTION_KEY=your_encryption_key_minimum_32_chars

# Payment Processing (Future Integration)
PAYMENT_GATEWAY_KEY=your_payment_gateway_key
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret

# Email Service (For notifications)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_email@disbaumusic.com
SMTP_PASSWORD=your_smtp_password

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Feature Flags
ENABLE_REFERRAL_PROGRAM=false
ENABLE_AFFILIATE_PROGRAM=false
ENABLE_WITHDRAWAL=true
MINIMUM_WITHDRAWAL_AMOUNT=50000
