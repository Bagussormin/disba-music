TUNECORE_WEBHOOK_SECRET=your_tunecore_webhook_secret

# Apple Music / MusicKit Configuration
APPLE_MUSIC_DISTRIBUTION_API_URL=https://musickit-api.music.apple.com
APPLE_MUSIC_DISTRIBUTION_API_KEY=your_apple_music_api_key
APPLE_MUSIC_WEBHOOK_SECRET=your_apple_music_webhook_secret

# Database Configuration
