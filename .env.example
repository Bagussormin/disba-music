# Example Environment Variables - COPY TO .env.production FOR PRODUCTION
# DO NOT commit actual secrets to git

VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

VITE_API_URL=https://your-api-domain.com
VITE_APP_ENV=production

NODE_ENV=production
PORT=3001

SPOTIFY_CLIENT_ID=your_id
SPOTIFY_CLIENT_SECRET=your_secret
SPOTIFY_REDIRECT_URI=https://your-domain.com/callback/spotify
SPOTIFY_API_BASE_URL=https://api.spotify.com/v1
SPOTIFY_WEBHOOK_SECRET=your_webhook_secret

TUNECORE_DISTRIBUTION_API_URL=https://api.tunecore.com/v1
TUNECORE_DISTRIBUTION_API_KEY=your_key
TUNECORE_WEBHOOK_SECRET=your_webhook_secret

APPLE_MUSIC_DISTRIBUTION_API_URL=https://musickit-api.music.apple.com
APPLE_MUSIC_DISTRIBUTION_API_KEY=your_key
APPLE_MUSIC_WEBHOOK_SECRET=your_webhook_secret

DATABASE_URL=postgresql://user:pass@host:5432/database

JWT_SECRET=your_jwt_secret_minimum_32_characters_required_here
ENCRYPTION_KEY=your_encryption_key_minimum_32_characters_required

PAYMENT_GATEWAY_KEY=your_key
PAYMENT_WEBHOOK_SECRET=your_secret

SMTP_HOST=your_host
SMTP_PORT=587
SMTP_USER=your_email
SMTP_PASSWORD=your_password

LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn

ENABLE_REFERRAL_PROGRAM=false
ENABLE_AFFILIATE_PROGRAM=false
ENABLE_WITHDRAWAL=true
MINIMUM_WITHDRAWAL_AMOUNT=50000
