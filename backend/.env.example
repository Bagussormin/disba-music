# ============================================================
# DISBA MUSIC — PRODUCTION ENVIRONMENT TEMPLATE
# Salin file ini ke .env di server produksi (Railway/VPS)
# ============================================================

# 1. SUPABASE CONFIGURATION
# Dapatkan dari: Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_KEY=your_service_role_key_here

# 2. SERVER & FRONTEND CONFIG
# URL frontend Anda (tanpa trailing slash)
FRONTEND_URL=https://disbamusic.id
PORT=3001

# 3. SPOTIFY API (Lookup & Verification)
# Daftar di: https://developer.spotify.com
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_WEBHOOK_SECRET=generate_a_random_secure_string_here

# 4. DDEX SENDER IDENTITY
# Gunakan ID default jika belum punya DDEX membership resmi
DDEX_SENDER_PARTY_ID=PADPIDA2026051001A
DDEX_SENDER_NAME=PT Disba Music Indonesia
DDEX_DPID=PADPIDA2026051001A

# 5. AGGREGATOR PARTNERS (Optional)
# Set jika menggunakan TuneCore/Apple Partner API
TUNECORE_DISTRIBUTION_API_URL=
TUNECORE_DISTRIBUTION_API_KEY=
TUNECORE_WEBHOOK_SECRET=

APPLE_MUSIC_DISTRIBUTION_API_URL=https://api.music.apple.com/v1/
APPLE_MUSIC_DISTRIBUTION_API_KEY=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=

# 6. ROYALTY & COMMISSION SETTINGS
# Persentase komisi platform (15 = 15%)
SPOTIFY_COMMISSION_PERCENTAGE=15
# Kurs konversi USD ke IDR untuk pembayaran artist
USD_TO_IDR_RATE=16000
# Minimal saldo penarikan (IDR)
MINIMUM_WITHDRAWAL_AMOUNT=50000

# 7. SECURITY
# Secret generic untuk webhook internal
WEBHOOK_SECRET=generate_another_random_string_here
