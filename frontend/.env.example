# ============================================================
# DISBA MUSIC — FRONTEND PRODUCTION TEMPLATE
# Salin file ini ke .env di Vercel/Netlify/Hosting
# ============================================================

# 1. SUPABASE CONFIGURATION
# Dapatkan dari: Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# 2. BACKEND API URL
# URL backend Railway Anda (tanpa trailing slash)
# Contoh: https://disba-music-production.up.railway.app
VITE_API_URL=https://your-backend-api.com
